# Copier ce fichier en .env et remplacer les valeurs. Ne pas mettre .env dans git.
SECRET_KEY=remplacer-par-une-longue-cle-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://travelhub:motdepasse@localhost:5432/travelhub
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Facultatif. Mot de passe des comptes créés par « manage.py seed_demo ».
# DEMO_PASSWORD=
# Facultatif. Limites de requêtes de l'API pour les anonymes et les utilisateurs connectés.
# THROTTLE_ANON_RATE=100/hour
# THROTTLE_USER_RATE=1000/hour
# Facultatif. Journaux JSON : niveau global, niveau de Django et fichier rotatif.
# Si LOG_FILE est vide, les journaux vont seulement sur la console.
# LOG_LEVEL=INFO
# DJANGO_LOG_LEVEL=INFO
# LOG_FILE=logs/travelhub.log

# Pour docker compose (docker-compose.yml) : base du conteneur db et compte pgAdmin.
# Le service web construit son propre DATABASE_URL (hôte db). Évitez @ : / dans le mot de passe.
POSTGRES_USER=travelhub
POSTGRES_PASSWORD=motdepasse
POSTGRES_DB=travelhub
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=motdepasse-pgadmin
# Facultatif. Ports publiés (8000 et 5050 par défaut) et nombre de processus Gunicorn (2 par défaut).
# WEB_PORT=8000
# PGADMIN_PORT=5050
# WEB_CONCURRENCY=2
