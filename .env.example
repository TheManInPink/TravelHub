# Copier ce fichier en .env puis remplacer les valeurs. Ne jamais versionner .env.
SECRET_KEY=remplacer-par-une-longue-cle-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://travelhub:motdepasse@localhost:5432/travelhub
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Facultatif : mot de passe des comptes créés par « manage.py seed_demo ».
# DEMO_PASSWORD=
# Facultatif : limites de requêtes de l'API (anonymes, utilisateurs connectés).
# THROTTLE_ANON_RATE=100/hour
# THROTTLE_USER_RATE=1000/hour

# docker compose (docker-compose.yml) : base du conteneur db et compte pgAdmin.
# Le service web y construit son propre DATABASE_URL (hôte db) ; évitez @ : / dans le mot de passe.
POSTGRES_USER=travelhub
POSTGRES_PASSWORD=motdepasse
POSTGRES_DB=travelhub
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=motdepasse-pgadmin
# Facultatif : ports publiés (défauts 8000 et 5050), processus Gunicorn (défaut 2).
# WEB_PORT=8000
# PGADMIN_PORT=5050
# WEB_CONCURRENCY=2
