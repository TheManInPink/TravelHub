# Copier ce fichier en .env, puis remplir les valeurs. Ne jamais mettre .env dans git.
# Chaque variable a un exemple en commentaire au-dessus d'elle.
# Les lignes qui commencent par « # NOM= » sont facultatives et ont une valeur par défaut.

# Clé de signature de Django et des JWT, d'au moins 50 caractères.
# Exemple (à générer) : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Exemple : localhost,127.0.0.1 (en production, l'hôte Render et localhost)
ALLOWED_HOSTS=
# Exemple : postgres://travelhub:motdepasse@localhost:5432/travelhub
# Avec Neon, on ajoute ?sslmode=require à la fin de l'URL.
DATABASE_URL=
# Exemple : http://localhost:3000 (en production, https://<projet>.vercel.app)
CORS_ALLOWED_ORIGINS=

# Facultatif. Exemple : True (valeur par défaut en développement, ignorée en production)
# DEBUG=
# Facultatif. Regex des previews Vercel, séparées par « ; », car une regex peut contenir une virgule.
# Exemple : ^https://travelhub-[a-z0-9-]+-<équipe>\.vercel\.app$
# CORS_ALLOWED_ORIGIN_REGEXES=
# Facultatif. Seul hôte accepté pour l'image de couverture d'un voyage (cover_image_url).
# Exemple : <ref>.supabase.co
# SUPABASE_STORAGE_HOST=
# Facultatif. Nombre de proxys devant Gunicorn, pour que la limite de requêtes prenne la bonne adresse IP.
# Exemple : 1 (sur Render)
# NUM_PROXIES=
# Facultatif. Mot de passe des comptes créés par « manage.py seed_demo ».
# Exemple : un mot de passe d'au moins 8 caractères, différent en production
# DEMO_PASSWORD=
# Facultatif. Limites de requêtes pour les anonymes et pour les utilisateurs connectés.
# Exemple : 100/hour et 1000/hour (300/hour pour les anonymes en production, derrière Vercel)
# THROTTLE_ANON_RATE=
# THROTTLE_USER_RATE=
# Facultatif. Durée de vie des connexions PostgreSQL, en secondes. Exemple : 60
# DB_CONN_MAX_AGE=
# Facultatif. Niveaux des journaux JSON de l'application et de Django. Exemple : INFO
# LOG_LEVEL=
# DJANGO_LOG_LEVEL=
# Facultatif. Fichier rotatif des journaux. Exemple : logs/travelhub.log
# Une valeur vide écrit seulement sur la console (c'est ce qu'on veut sur Render).
# LOG_FILE=

# Production seulement (config.settings.prod).
# Facultatif. Origines HTTPS de confiance pour l'admin. Exemple : https://<service>.onrender.com
# CSRF_TRUSTED_ORIGINS=
# Facultatif. Exemple : True (False dans docker compose en local, qui n'a pas de HTTPS)
# SECURE_SSL_REDIRECT=
# Facultatif. Durée HSTS en secondes. Exemple : 2592000 (30 jours, 0 dans docker compose)
# SECURE_HSTS_SECONDS=

# Gunicorn (gunicorn.conf.py).
# Facultatif. Port d'écoute, donné par Render. Exemple : 10000 (8000 par défaut)
# À ne pas définir pour docker compose, qui publie le port 8000 du conteneur.
# PORT=
# Facultatif. Adresse complète, prioritaire sur PORT. Exemple : 0.0.0.0:8000
# GUNICORN_BIND=
# Facultatif. Nombre de processus Gunicorn. Exemple : 2
# WEB_CONCURRENCY=

# Pour docker compose (docker-compose.yml) : base du conteneur db et compte pgAdmin.
# Le service web construit son propre DATABASE_URL (hôte db). Évitez @ : / dans les mots de passe.
# Exemple : travelhub (valeur par défaut si vide)
POSTGRES_USER=
# Exemple : un mot de passe pour le conteneur db (obligatoire pour docker compose)
POSTGRES_PASSWORD=
# Exemple : travelhub (valeur par défaut si vide)
POSTGRES_DB=
# Exemple : admin@example.com (valeur par défaut si vide)
PGADMIN_DEFAULT_EMAIL=
# Exemple : un mot de passe pour pgAdmin (obligatoire pour docker compose)
PGADMIN_DEFAULT_PASSWORD=
# Facultatif. Ports publiés sur l'hôte. Exemple : 8000 et 5050
# WEB_PORT=
# PGADMIN_PORT=
