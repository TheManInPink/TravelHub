# Copier ce fichier en .env.local, puis remplir les valeurs. Ne jamais mettre .env.local dans git.
# Chaque variable a un exemple en commentaire au-dessus d'elle.
# Seules les variables NEXT_PUBLIC_ arrivent dans le navigateur, et leur valeur est figée au build.

# URL de l'API Django, sans « / » à la fin. Lue seulement par le serveur Next.js.
# Exemple : http://localhost:8000 (en production, https://<service>.onrender.com)
DJANGO_API_URL=

# Projet Supabase qui garde les images. Sert aussi à images.remotePatterns de next.config.ts.
# Exemple : https://<ref>.supabase.co
SUPABASE_URL=
# Clé secrète du projet (Settings > API Keys). Elle commence par sb_secret_.
# Serveur seulement : ne jamais lui donner le préfixe NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Bucket public des images. Exemple : travelhub-images
SUPABASE_BUCKET=

# Adresse publique du site, pour metadataBase.
# Exemple : http://localhost:3000 (en production, https://<projet>.vercel.app)
NEXT_PUBLIC_SITE_URL=
