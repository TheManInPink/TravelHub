# Configuration de coverage.py, lue par pytest-cov (voir pytest.ini).
[run]
source =
    apps
    config
branch = true
omit =
    */migrations/*
    */tests/*
    # Points d'entrée WSGI et ASGI, que les tests n'importent jamais.
    config/asgi.py
    config/wsgi.py

[report]
# Pas de fail_under ici, sinon « pytest un_fichier.py » échouerait. Pour la suite
# complète, on met le seuil avec pytest --cov-fail-under=80.
show_missing = true
skip_covered = true

[html]
directory = htmlcov
title = TravelHub : couverture des tests
